import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {createWorld,buildBracket} from '../packages/domain/src/index.ts';
import {IDS,unwrap} from '../tests/fixtures/domain.ts';
import {CupBracket} from '../apps/client/src/features/competitions/cup-bracket.tsx';
const require=createRequire(new URL('../apps/client/package.json',import.meta.url));
const React=require('react');const {renderToStaticMarkup}=require('react-dom/server');
const state=unwrap(createWorld({id:IDS.league,userId:IDS.user,name:'Check',mode:'offline',now:Date.parse('2026-10-27T15:00:00Z')}));
const ids=state.clubs.ids.slice(0,8);
const cups=[...unwrap(buildBracket(ids,'copa-brasil',[1,2,3]))];
const render=(nodes)=>renderToStaticMarkup(React.createElement(CupBracket,{state:{...state,cups:nodes,results:[]},competitionId:'copa-brasil'}));
const html=render(cups);
const phases=[...html.matchAll(/<h2>(.*?)<\/h2>/g)].map(match=>match[1]);
assert.equal(phases.length,1);
assert.ok(phases[0].startsWith('Quartas de final'));
assert.equal((html.match(/class="cup-tie"/g)||[]).length,4);
const partlyKnown=cups.map((node,index)=>index===0?{...node,awayId:null}:node);
assert.equal((render(partlyKnown).match(/class="cup-tie"/g)||[]).length,3);
assert.ok(!render(cups.map(node=>({...node,homeId:null,awayId:null}))).includes('cup-round-card'));
console.log('Only defined games and phases rendered; hidden semifinals/final retain correct phase names.');
