{
  "name": "football-manager-brasil",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "turbo run dev",
    "assets": "node scripts/generate-models.mjs",
    "data:fetch": "pnpm --filter @football/server exec tsx --env-file-if-exists=.env src/providers/cli.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.tools.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --typecheck",
    "test:coverage": "vitest run --typecheck --coverage",
    "test:e2e": "playwright test",
    "emulators": "pnpm --filter @football/functions build && firebase emulators:start --project demo-football-manager",
    "test:emulators": "turbo run build --filter=@football/server && firebase emulators:exec --project demo-football-manager --only auth,firestore \"node --test tests/emulators/*.test.mjs\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "prepare": "husky",
    "data:import": "turbo run build --filter=@football/domain && pnpm --filter @football/server exec tsx --env-file-if-exists=.env src/providers/import-cli.ts",
    "data:bootstrap": "turbo run build --filter=@football/domain && pnpm --filter @football/server exec tsx --env-file-if-exists=.env src/providers/bootstrap-api-football.ts",
    "data:local": "turbo run build --filter=@football/domain && pnpm --filter @football/server exec tsx src/providers/import-local-players.ts",
    "data:extract": "node scripts/extract-local-players.mjs",
    "data:update": "pnpm --filter @football/server exec tsx src/providers/prepare-source-update.ts && pnpm data:local && pnpm --filter @football/server exec tsx ../../scripts/update-player-appearance.mts",
    "dev:local": "pnpm --filter @football/domain... build && turbo run dev --filter=@football/client --filter=@football/worker",
    "dev:online": "turbo run dev --filter=@football/client"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "5.0.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.3.0",
    "firebase": "12.19.0",
    "firebase-tools": "^15.34.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css,html}": "prettier --write"
  }
}
