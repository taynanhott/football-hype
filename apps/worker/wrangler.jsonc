{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-hype-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "CLIENT_ORIGIN": "https://football-hype.taynanzhott.workers.dev",
    "FIREBASE_PROJECT_ID": "football-hype",
    "FIREBASE_PROJECT_NUMBER": "717966218493",
    "USAGE_METRICS": "false",
  },
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "GameHubV2" }] },
  "migrations": [{ "tag": "v1-reactivated", "new_sqlite_classes": ["GameHubV2"] }],
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
}
